<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Weak / lost connection: page is blurred behind this card -->
    <FrameLayout
        android:id="@+id/weakView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="28dp"
            android:layout_marginRight="28dp"
            android:background="@drawable/bg_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_icon_circle_warn">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_wifi_off"
                    android:tint="@color/warn" />
            </FrameLayout>

            <TextView
                android:id="@+id/weakTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="@string/weak_title"
                android:textColor="@color/text"
                android:textDirection="rtl"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/weakText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/weak_text"
                android:textColor="@color/text2"
                android:textDirection="rtl"
                android:textSize="14sp" />

            <Button
                android:id="@+id/weakRetryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button_ghost"
                android:minHeight="44dp"
                android:paddingLeft="28dp"
                android:paddingRight="28dp"
                android:text="@string/check_again"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textDirection="rtl"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Loading -->
    <LinearLayout
        android:id="@+id/loadingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@null"
            android:src="@drawable/logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/loading"
            android:textColor="@color/text"
            android:textDirection="rtl"
            android:textSize="17sp" />

        <ProgressBar
            android:id="@+id/loadingProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="160dp"
            android:layout_height="4dp"
            android:layout_marginTop="16dp"
            android:max="100"
            android:progressBackgroundTint="#24FFFFFF"
            android:progressTint="@color/brand" />

        <TextView
            android:id="@+id/loadingHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/loading_slow"
            android:textColor="@color/warn"
            android:textDirection="rtl"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Error (no internet / server / secure connection) -->
    <LinearLayout
        android:id="@+id/errorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:background="@drawable/bg_icon_circle">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_wifi_off"
                android:tint="@color/brand" />
        </FrameLayout>

        <TextView
            android:id="@+id/errorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/error_offline_title"
            android:textColor="@color/text"
            android:textDirection="rtl"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.25"
            android:text="@string/error_offline_text"
            android:textColor="@color/text2"
            android:textDirection="rtl"
            android:textSize="15sp" />

        <Button
            android:id="@+id/refreshButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_button"
            android:minHeight="50dp"
            android:paddingLeft="44dp"
            android:paddingRight="44dp"
            android:text="@string/refresh"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textDirection="rtl"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
