<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Hamseda" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/bg</item>
        <!-- transparent system bars: the app draws their colour itself, following the site's theme -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
